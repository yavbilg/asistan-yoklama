# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
# .env.local git'e girmez (.gitignore'da).

# Postgres bağlantı adresi.
# Vercel > Storage'dan veritabanı eklendiğinde projeye otomatik tanımlanır.
# Yerelde çalışmak için panelden kopyalayıp buraya yapıştırın.
DATABASE_URL="postgres://kullanici:parola@sunucu:5432/veritabani?sslmode=require"

# QR imzalama anahtarı (isteğe bağlı). Tanımlanmazsa veritabanında bir kez
# rastgele üretilip saklanır; kodda sabit bir değere DÜŞÜLMEZ.
TOKEN_SECRET="buraya-uzun-rastgele-bir-deger"

# Yönetici şifresi: asistanın telefon kaydını sıfırlamak için gerekir
# (telefon değişti, yanlış isim seçildi). Tanımlanmazsa sıfırlama kapalıdır.
ADMIN_PASSWORD="kendi-belirlediginiz-sifre"
